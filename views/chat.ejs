<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> - WapsApp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="header">
        <% if (avatar) { %>
            <img class="header-avatar" src="<%= avatar %>">
        <% } %>
        <span class="header-title"><%= title %></span>
        <a href="/" style="color:#ffffff;float:right;">Back</a>
    </div>

    <div class="toolbar">
        <div class="status live" id="statusBox">LIVE</div>
        <button class="probebtn" id="probeBtn" onclick="probeNow()">Probe</button>
        <a href="/chat/<%= chatId %>/search">Search</a> | <a href="/chat/<%= chatId %>/about">About</a>
    </div>

    <div id="seeMore" class="seemore"><a href="#" onclick="loadOlder(); return false;">See more above</a></div>

    <div class="messages" id="messages">
        <% messages.forEach(function(m) { %>
            <div class="msg <%= m.fromMe ? 'out' : 'in' %>" data-ts="<%= m.timestamp %>">
                <b><%= m.name %>:</b>
                <%- m.text %>
                <% if (m.hasMedia) { %>
                    <% var mediaUrl = '/media/' + encodeURIComponent(m.id) + '/' + encodeURIComponent(chatId); %>
                    <% if (m.mediaType === 'image') { %>
                        <br><img class="thumb" src="<%= mediaUrl %>?quality=thumb" loading="lazy">
                        <br><a href="<%= mediaUrl %>" target="_blank">View full</a>
                    <% } else if (m.mediaType === 'ptt' || m.mediaType === 'audio') { %>
                        <br><audio controls src="<%= mediaUrl %>">Your browser does not support audio playback.</audio>
                        <br><a href="<%= mediaUrl %>" target="_blank">View full</a>
                    <% } else if (m.mediaType === 'video') { %>
                        <br><a href="<%= mediaUrl %>" target="_blank">View full</a> | <a href="<%= mediaUrl %>?quality=480" target="_blank">480p</a> | <a href="<%= mediaUrl %>?quality=360" target="_blank">360p</a>
                    <% } else { %>
                        <br><a href="<%= mediaUrl %>" target="_blank">View attachment<% if (m.mimetype) { %> (<%= m.mimetype %>)<% } %></a>
                    <% } %>
                <% } %>
                <span class="time"><%= new Date(m.timestamp * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
        <% }); %>
    </div>

    <form class="sendform" id="sendForm" method="post" action="/chat/<%= chatId %>/send" enctype="multipart/form-data">
        <input type="text" name="text" id="textInput" autocomplete="off">
        <input type="file" name="media" id="mediaInput">
        <input type="submit" value="Send" id="sendBtn">
    </form>

    <script src="/poll.js?v=3"></script>
    <script>
        var CHAT_ID = "<%= chatId %>";
        var LAST_TS = <%= messages.length ? messages[messages.length - 1].timestamp : 0 %>;
        var OLDEST_TS = <%= messages.length ? messages[0].timestamp : Math.floor(Date.now()/1000) %>;
        startPolling(CHAT_ID, LAST_TS);
        scrollToBottom();
        document.getElementById('sendForm').addEventListener('submit', sendMessage);
    </script>
</body>
</html>
