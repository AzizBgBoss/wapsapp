+                    (Msg.getModelsArray && Msg.getModelsArray()) ||
+                    Msg.models ||
+                    Msg._models ||
+                    [];
+                const match = models.find((m) => (m.id?._serialized || m.id?.$1) === wanted);
+                if (match) return match;
+            }
+        } catch (ignoredError) {
+            /* give up */
+        }
+
+        return null;
+    };
